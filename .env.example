DATABASE_URL=postgres://yar:yar_dev@localhost:5432/yar
YAR_ADDR=:8080
YAR_DEV_MODE=true

# Optional model providers (Mock provider works without keys)
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Production OAuth resource-server configuration.
# These are required when YAR_DEV_MODE is not true.
# The authorization server should issue/introspect access tokens whose `sub`
# is the canonical YAR user UUID and whose audience includes YAR_MCP_RESOURCE_URL.
YAR_MCP_RESOURCE_URL=https://api.example.com/mcp
YAR_AUTHORIZATION_SERVER=https://auth.example.com
YAR_AUTH_INTROSPECTION_URL=https://auth.example.com/oauth2/introspect
YAR_AUTH_CLIENT_ID=
YAR_AUTH_CLIENT_SECRET=

# Core scopes are always advertised by YAR:
# - yar:profile:read
# - yar:team:run
# Add deployment-specific scopes here if needed.
YAR_AUTH_SUPPORTED_SCOPES=yar:profile:read yar:team:run
